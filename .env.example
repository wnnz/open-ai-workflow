APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
DATABASE_URL=postgresql+asyncpg://ordo:ordo@postgres:5432/ordo
REDIS_URL=redis://redis:6379/0
STORAGE_PATH=/data/files
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:5173
SANDBOX_URL=http://sandbox:8081
SANDBOX_SHARED_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
MAX_REQUEST_BODY_BYTES=52428800
PUBLIC_RATE_LIMIT_REQUESTS=30
PUBLIC_ACCESS_RATE_LIMIT_REQUESTS=10
PUBLIC_UPLOAD_RATE_LIMIT_REQUESTS=10
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_MAX_ACTIVE_RUNS_PER_APP=10
WORKFLOW_RUN_LEASE_SECONDS=120
WORKFLOW_PENDING_RECOVERY_SECONDS=60
FILE_UPLOAD_RETENTION_HOURS=24
FILE_OUTPUT_RETENTION_DAYS=30
FILE_ORPHAN_GRACE_HOURS=24
FILE_CLEANUP_BATCH_SIZE=500
HOST_HTTP_PROXY=http://127.0.0.1:10808
CONTAINER_HTTP_PROXY=http://host.docker.internal:10808
NO_PROXY=localhost,127.0.0.1,postgres,redis,api,worker,sandbox,sandbox-docker-proxy
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
ALERT_WEBHOOK_URL=
