APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
DATABASE_URL=postgresql+asyncpg://openworkflow:openworkflow@postgres:5432/openworkflow
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=openworkflow
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=openworkflow
MINIO_SECURE=false
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:5173
SANDBOX_URL=http://sandbox:8081
DOCUMENT_WORKER_URL=http://document-worker:8082
HOST_HTTP_PROXY=http://127.0.0.1:10808
CONTAINER_HTTP_PROXY=http://host.docker.internal:10808
NO_PROXY=localhost,127.0.0.1,postgres,redis,minio,api,worker,sandbox,document-worker
